{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "ignorePatterns": ["pnpm-lock.yaml", "dist/**"],
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["type-internal", "type-subpath", "type-parent", "type-sibling", "type-index"],
      ["internal", "subpath", "parent", "sibling", "index"],
      "unknown"
    ]
  }
}
