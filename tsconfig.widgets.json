{
  // Type-checks the BROWSER widget source (the entries excluded from the two node-side
  // tsconfigs): each widget's `main.ts`, the shared `mount-widget.ts`, and the `.svelte`
  // components. esbuild bundles these (stripping types without checking — ADR-0019); this
  // config is what `svelte-check` reads so the same files are actually typechecked.
  // `pnpm typecheck` chains `typecheck:widgets`, so the pre-push hook and CI cover it.
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/node24/tsconfig.json"],
  "compilerOptions": {
    // Browser globals (document, performance, setTimeout→number), NOT Node — these run in a
    // sandboxed iframe. `types: []` drops @types/node so server-only globals can't leak in.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true
  },
  // The three browser-entry shapes, mirroring the excludes in tsconfig.json / tsconfig.test.json.
  // The node-side widget files (module.ts, api.ts, artifacts.ts, resources/) stay with `tsc`.
  "include": [
    "src/features/widgets/mount-widget.ts",
    "src/features/widgets/*/main.ts",
    "src/features/widgets/shared/**/*.ts",
    "src/features/widgets/**/*.svelte"
  ]
}
