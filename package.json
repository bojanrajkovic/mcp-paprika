{
  "name": "@bojanrajkovic/mcp-paprika",
  "version": "1.6.0",
  "description": "MCP server for Paprika recipe manager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bojanrajkovic/mcp-paprika"
  },
  "bin": {
    "mcp-paprika": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && pnpm build:widgets",
    "build:widgets": "tsx scripts/build-widgets.ts",
    "dev": "tsx src/index.ts",
    "dev:preview": "tsx scripts/widget-preview.ts",
    "dev:widgets": "tsx scripts/build-widgets.ts --watch",
    "format": "oxfmt --write . && pnpm format:svelte",
    "format:svelte": "prettier --plugin prettier-plugin-svelte --write \"src/**/*.svelte\"",
    "generate:fixtures": "tsx scripts/generate-har-fixtures.ts",
    "generate:modules": "tsx scripts/generate-kernel-modules.ts",
    "generate:tool-reference": "tsx scripts/generate-tool-reference.ts",
    "format:check": "oxfmt --check . && pnpm format:svelte:check",
    "format:svelte:check": "prettier --plugin prettier-plugin-svelte --check \"src/**/*.svelte\"",
    "lint": "oxlint --deny-warnings src/ test/",
    "lint:fix": "oxlint --fix src/ test/",
    "prepare": "lefthook install",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:external": "vitest run --project external",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && pnpm typecheck:widgets",
    "typecheck:widgets": "svelte-check --tsconfig ./tsconfig.widgets.json --fail-on-warnings"
  },
  "dependencies": {
    "@hono/mcp": "0.3.2",
    "@hono/node-server": "2.0.12",
    "@hono/otel": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-net": "^0.68.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resource-detector-container": "^0.9.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "async-mutex": "^0.5.0",
    "cockatiel": "^4.0.0",
    "dotenv": "^17.4.2",
    "env-paths": "^4.0.0",
    "hono": "4.13.14",
    "hono-rate-limiter": "^0.5.4",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "neverthrow": "^8.2.0",
    "parse-duration": "^2.1.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@msw/source": "^0.7.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/har-format": "^1.2.16",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "msw": "^3.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@11.28.6"
}
