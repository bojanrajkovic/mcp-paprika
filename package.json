{
  "name": "@bojanrajkovic/mcp-paprika",
  "version": "1.6.0",
  "description": "MCP server for Paprika recipe manager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bojanrajkovic/mcp-paprika"
  },
  "bin": {
    "mcp-paprika": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/configuration.md",
    "docs/http-transport.md",
    "docs/oauth-configuration.md",
    "docs/quick-start-http.md",
    "docs/deployment.md",
    "docs/embedding-providers.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "format": "oxfmt --write .",
    "generate:fixtures": "tsx scripts/generate-har-fixtures.ts",
    "generate:modules": "tsx scripts/generate-kernel-modules.ts",
    "generate:tool-reference": "tsx scripts/generate-tool-reference.ts",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src/ test/",
    "lint:fix": "oxlint --fix src/ test/",
    "prepare": "lefthook install",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:external": "vitest run --project external",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/mcp": "0.2.5",
    "@hono/node-server": "1.19.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "async-mutex": "^0.5.0",
    "cockatiel": "^3.2.1",
    "dotenv": "^17.4.2",
    "env-paths": "^4.0.0",
    "hono": "4.12.23",
    "hono-rate-limiter": "^0.5.3",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.2.3",
    "luxon": "^3.7.2",
    "neverthrow": "^8.2.0",
    "parse-duration": "^2.1.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "undici": "^8.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@msw/source": "^0.6.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/har-format": "^1.2.16",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.13.1",
    "@vitest/coverage-v8": "^4.1.8",
    "fast-check": "^4.8.0",
    "lefthook": "^2.1.9",
    "msw": "^2.14.6",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@11.5.2"
}
